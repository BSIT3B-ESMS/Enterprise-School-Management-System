APP_NAME="PLP Online Admission"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Demo default: SQLite (no database server needed; the file is created for you).
# MySQL (local or Amazon RDS in production): use these lines instead.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=admission_system
# DB_USERNAME=admission_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Demo default: written to storage/logs/laravel.log, nothing is sent.
# Production (decision T3): MAIL_MAILER=failover = Gmail SMTP, Brevo relay as backup.
MAIL_MAILER=log
MAIL_FAILOVER_MAILERS=gmail,brevo
MAIL_FROM_ADDRESS="admissions@plpasig.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Uploaded documents (decision T5): local | dms
DOCUMENT_STORE=local
ADMISSION_UPLOAD_MAX_KB=5120
DMS_BASE_URL=
DMS_API_KEY=
DMS_TIMEOUT=20

# Enrollment system (off until it exists)
ENROLLMENT_ENABLED=false
ENROLLMENT_BASE_URL=
ENROLLMENT_API_KEY=
ENROLLMENT_INBOUND_KEY=

# Backups (php artisan app:backup; nightly in the scheduler)
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_PATH=mysqldump

# 2FA by email code for applicants (off until the UI has a code screen)
APPLICANT_EMAIL_2FA=false

# First sysadmin account (db:seed). Leave the password empty to generate one.
SYSADMIN_EMAIL=sysadmin@plpasig.edu.ph
SYSADMIN_PASSWORD=

PULSE_ENABLED=true
