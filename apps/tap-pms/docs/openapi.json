  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PayrollPeriod": {
        "type": "object",
        "required": [
          "period_id",
          "starts_on",
          "ends_on",
          "status",
          "updated_at"
        ],
        "properties": {
          "period_id": {
            "type": "string",
            "format": "uuid"
          },
          "starts_on": {
            "type": "string",
            "format": "date"
          },
          "ends_on": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "released"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payslip": {
        "type": "object",
        "properties": {
          "payslip_id": {
            "type": "string",
            "format": "uuid"
          },
          "period_id": {
            "type": "string",
            "format": "uuid"
          },
          "employee_no": {
            "type": "string",
            "example": "26-00001"
          },
          "gross_pay": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$",
            "example": "35000.00"
          },
          "deductions": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$",
            "example": "35000.00"
          },
          "net_pay": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$",
            "example": "35000.00"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "released"
            ]
          },
          "released_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deduction_breakdown": {
            "type": "object",
            "description": "Employee statutory shares and recurring loan for this immutable calculation; older snapshots can return an empty object. Other approved adjustments remain included in total deductions.",
            "additionalProperties": false,
            "properties": {
              "sss": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "gsis": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "philhealth": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "pagibig": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "tax": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              },
              "loan": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
              }
            }
          }
        }
      },
      "PayrollPeriodInput": {
        "type": "object",
        "required": [
          "starts_on",
          "ends_on"
        ],
        "properties": {
          "starts_on": {
            "type": "string",
            "format": "date"
          },
          "ends_on": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PayslipInput": {
        "type": "object",
        "required": [
          "period_id",
          "employee_no"
        ],
        "properties": {
          "period_id": {
            "type": "string",
            "format": "uuid"
          },
          "employee_no": {
            "type": "string",
            "example": "26-00001"
          }
        },
        "additionalProperties": false,
        "description": "Amounts are computed on the server. Supplied gross_pay, deductions or net_pay are rejected. Released periods and existing payslips return 409. Release remains an authenticated administrator action."
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "object"
          }
        }
      }
    }
  }
}
